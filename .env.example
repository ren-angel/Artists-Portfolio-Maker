NODE_ENV=development
APP_ORIGIN=http://localhost:3000
PLATFORM_DOMAIN=localhost
PLATFORM_NAME=Muralia
API_INTERNAL_ORIGIN=http://127.0.0.1:4000
PORT=4000
HOST=127.0.0.1
DATABASE_URL=postgresql://studio:CHANGE_ME@localhost:5432/studio
DIRECT_DATABASE_URL=postgresql://studio:CHANGE_ME@localhost:5432/studio
POSTGRES_PASSWORD=CHANGE_ME
# Local Compose host port. Match both connection URLs if changed.
POSTGRES_PORT=5432
STORAGE_DRIVER=local
# Use an absolute path shared by API, cleanup and tests. Default resolves from apps/api.
# Set a persistent path (for example /home/you/project/.local/data).
LOCAL_DATA_DIR=/absolute/path/to/private/artist-studio-data
MAIL_DRIVER=file
# MAIL_DRIVER=resend
# MAIL_FROM=Studio <studio@your-domain>
# RESEND_API_KEY=
# STORAGE_DRIVER=s3
# S3_ENDPOINT=http://localhost:9000
# S3_REGION=us-east-1
# S3_BUCKET=artwork
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# MINIO_ROOT_USER=
# MINIO_ROOT_PASSWORD=
# MAX_SITES=1
# MAX_PAGES=5
# MAX_ARTWORKS=50
# MAX_STORAGE_BYTES=209715200
# MAX_UPLOAD_BYTES=12582912
# TEST_DATABASE_URL=postgresql://studio:CHANGE_ME@localhost:5432/studio_test

# --- Phase 2: billing, domains, analytics ---------------------------------
# mock = local simulator (no money moves). asaas = real provider.
BILLING_DRIVER=mock
# sandbox or production (Asaas). Production NODE_ENV requires the asaas driver.
# ASAAS_ENV=sandbox
# ASAAS_API_KEY=
# Shared secret Asaas sends in the asaas-access-token header (32-255 chars,
# no spaces, not an API key). Set the same value on the Asaas webhook.
# BILLING_WEBHOOK_TOKEN=
# Optional price overrides in centavos, e.g.
# PLAN_PRICES={"artist":{"monthly":1290,"yearly":12900},"studio":{"monthly":2490,"yearly":24900}}
# Secret shared by the web and API servers (analytics and domain lookups).
# INTERNAL_TOKEN=
# Where artists point custom domains: CNAME target and apex A record.
# DOMAIN_TARGET=sites.your-domain.example
# DOMAIN_TARGET_IP=
# probe = report HTTPS as active only after a real TLS handshake succeeds.
# DOMAIN_TLS_CHECK=probe
# Trusted edge header carrying a two-letter country (e.g. cf-ipcountry).
# ANALYTICS_COUNTRY_HEADER=
# ANALYTICS_RETENTION_DAYS=400
# Shown in the draft legal pages.
# LEGAL_ENTITY_NAME=
# SUPPORT_EMAIL=
