{
  "name": "artists-portfolio-maker",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22.16"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @studio/web --filter @studio/api dev",
    "build": "pnpm --filter @studio/api build && pnpm --filter @studio/web build",
    "typecheck": "tsc --noEmit && pnpm --filter @studio/web typecheck",
    "lint": "eslint apps packages tests",
    "test": "node --env-file-if-exists=.env --import tsx --test tests/*.test.ts",
    "e2e": "node --env-file-if-exists=.env node_modules/@playwright/test/cli.js test",
    "migrate": "node --env-file-if-exists=.env --import tsx packages/db/src/migrate.ts",
    "seed": "node --env-file-if-exists=.env --import tsx scripts/seed.ts",
    "cleanup": "node --env-file-if-exists=.env --import tsx apps/api/src/cleanup.ts",
    "test:unit": "node --import tsx --test tests/model.test.ts tests/render.test.ts",
    "test:sql": "node --env-file-if-exists=.env scripts/test-sql.mjs",
    "db:test:migrate": "node --env-file-if-exists=.env --import tsx scripts/migrate-test.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@studio/api": "workspace:*",
    "@studio/db": "workspace:*",
    "@studio/shared": "workspace:*",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "dotenv-cli": "^11.1.0",
    "eslint": "^9.39.0",
    "fastify": "^5.6.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "sharp": "^0.34.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0"
  }
}
